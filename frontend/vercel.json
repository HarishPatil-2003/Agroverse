{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(css|js|assets|locales)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/crop.html",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard.html",
      "destination": "/index.html"
    },
    {
      "source": "/community.html",
      "destination": "/index.html"
    },
    {
      "source": "/marketplace.html",
      "destination": "/index.html"
    },
    {
      "source": "/schemes.html",
      "destination": "/index.html"
    },
    {
      "source": "/profile.html",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|css/|js/|locales/|pages/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
